# Host-specific Zsh config
apps/zsh/host-conf/*.sh

# nvim tmp files
apps/nvim/runtime/*
!apps/nvim/runtime/*.md

# tmux
apps/tmux/plugins

# mutt
apps/neomutt/*.info
apps/neomutt/cache

# Files and dirs to be ommited
conf/
conf_pub/
conf_host/
conf_cloud_cn/
conf_cloud_global/
private
scripts

# Alaritty
apps/alacritty/plugins/*
!apps/alacritty/plugins/README.md

# Byte-compiled Zsh. These are host-local build output derived from a source
# file that is either tracked or a plugin checkout; they are regenerated on
# demand and must never be committed. Nothing currently writes one inside this
# repository, and this keeps it that way.
*.zwc

# Other tmp files
*.swp
*~
*.pyc
.DS_Store
