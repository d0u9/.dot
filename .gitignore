# Whitelist: ignore everything at the top level, then re-include what we manage
/*
!/.gitignore
!/01-apps/
!/AGENTS.md
!/DEPENDENCIES.md
!/install.sh
!/LICENSE
!/README.md

# Host-specific Zsh config
01-apps/zsh/host-conf/*.sh

# nvim tmp files
01-apps/nvim/runtime/*
!01-apps/nvim/runtime/*.md

# tmux
01-apps/tmux/plugins

# mutt
01-apps/neomutt/*.info
01-apps/neomutt/cache

# Alaritty
01-apps/alacritty/plugins/*
!01-apps/alacritty/plugins/README.md

# Byte-compiled Zsh. These are host-local build output derived from a source
# file that is either tracked or a plugin checkout; they are regenerated on
# demand and must never be committed. Nothing currently writes one inside this
# repository, and this keeps it that way.
*.zwc

# Other tmp files
# Vim / Emacs
*.swp
*.swo
*.swn
*~
\#*#
.#*
Session.vim
.netrwhist

# Python
*.pyc
__pycache__/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
Icon?

# Windows / Linux
Thumbs.db
desktop.ini
.directory
.fuse_hidden*
.nfs*

# Generic
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log
