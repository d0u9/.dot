# This file is only useful to interactive shells. Keep non-interactive uses of
# BASH_ENV quiet and free of aliases, completion setup and prompt changes.
case $- in
    *i*) ;;
    *) return ;;
esac

# Resolve this file's symlink without readlink -f, which macOS does not ship.
# The installer creates an absolute link, but the loop also handles relative
# links so the configuration remains relocatable.
_dot_bash_source=${BASH_SOURCE[0]}
while [ -L "$_dot_bash_source" ]; do
    _dot_bash_dir=$(cd -P -- "$(dirname -- "$_dot_bash_source")" && pwd)
    _dot_bash_source=$(readlink "$_dot_bash_source")
    case $_dot_bash_source in
        /*) ;;
        *) _dot_bash_source=$_dot_bash_dir/$_dot_bash_source ;;
    esac
done
DOT_BASH_DIR=$(cd -P -- "$(dirname -- "$_dot_bash_source")" && pwd)
unset _dot_bash_source _dot_bash_dir

export DOT_LOG_LEVEL="${DOT_LOG_LEVEL:-warn}"
source "$DOT_BASH_DIR/../shell/lib.sh"
source "$DOT_BASH_DIR/../shell/go.sh"

_dot_prepend_path_if_dir "$HOME/.local/bin/scripts"
_dot_prepend_path_if_dir "$HOME/.local/bin"

if [ -d "$HOME/.local/share/man" ]; then
    case :${MANPATH:-}: in
        *:"$HOME/.local/share/man":*) ;;
        # A trailing colon keeps the system's default manpath when unset.
        *) if [ -n "${MANPATH:-}" ]; then
               MANPATH="$MANPATH:$HOME/.local/share/man"
           else
               MANPATH="$HOME/.local/share/man:"
           fi ;;
    esac
    export MANPATH
fi
if [[ $OSTYPE == linux* && -d $HOME/.local/lib ]]; then
    case :${LD_LIBRARY_PATH:-}: in
        *:"$HOME/.local/lib":*) ;;
        *) LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$HOME/.local/lib" ;;
    esac
    export LD_LIBRARY_PATH
fi
if [ -r "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

HISTSIZE=200000
HISTFILESIZE=200000
shopt -s histappend checkwinsize
HISTCONTROL=ignoreboth:erasedups

source "$DOT_BASH_DIR/aliases.bash"
source "$DOT_BASH_DIR/completion.bash"
source "$DOT_BASH_DIR/integrations.bash"
source "$DOT_BASH_DIR/prompt.bash"
