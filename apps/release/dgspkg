#!/bin/bash

set -euo pipefail

# The interactive shells export DOT_LOG_LEVEL=warn to keep startup quiet;
# this command reports what it installs.
DOT_LOG_LEVEL=info
DOT_DIR=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
source "$DOT_DIR/apps/shell/release.sh"

usage() {
    cat <<'HELP'
Usage: dgspkg COMMAND [ARGS]
Install official prebuilt releases into ~/.local/lib, linked from ~/.local/bin.
Short forms: i, up, rm, v, ls.

  install NAME [VERSION]  install one tool; VERSION is a version or a channel
                          such as stable or nightly (default: the one saved
                          by the last install, else the recipe's default).
                          The request is saved for later upgrades
  upgrade [NAME [VERSION]]
                          same as install; the previous version is kept.
                          Without NAME, upgrade every installed tool
  uninstall NAME          remove the tool and its link
  versions [-r] NAME      list versions on disk (* = current); switching
                          to one with install NAME VERSION needs no download.
                          -r lists channels and recent upstream releases
                          (* = current, + = on disk)
  list [-u]               show every tool with a recipe: CHANNEL is the saved
                          request (- when none), INSTALLED its version.
                          -u also fills TARGET and STATUS online: up to date,
                          update available or available (not installed)
HELP
}

case ${1:-} in
    upgrade|up) if [ $# -ge 2 ]; then release_install "$2" "${3:-}"; else release_upgrade_all; fi ;;
    install|i) [ $# -ge 2 ] || { usage >&2; exit 2; }; release_install "$2" "${3:-}" ;;
    uninstall|rm) [ $# -eq 2 ] || { usage >&2; exit 2; }; release_uninstall "$2" ;;
    versions|v)
        if [ "${2:-}" = -r ]; then
            [ $# -eq 3 ] || { usage >&2; exit 2; }; release_remote "$3"
        elif [ $# -eq 2 ]; then release_versions "$2"
        else usage >&2; exit 2; fi ;;
    list|ls)
        case ${2:-} in
            '') release_list ;;
            -u) release_list -u ;;
            *) usage >&2; exit 2 ;;
        esac ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
