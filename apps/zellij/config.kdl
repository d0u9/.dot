// Only the deltas from zellij's own default config live here; everything not
// mentioned is inherited, so an upgrade brings new defaults along for free.
// These overrides were last checked against zellij v0.45.1 default.kdl.
// Full list of options: https://zellij.dev/documentation/

keybinds {
    // Ctrl h is the default Move key and Ctrl b the default Tmux key. Free both,
    // move Move onto Ctrl b, and drop the tmux compat mode entirely.
    unbind "Ctrl h"
    unbind "Ctrl b"

    normal {
        // Quit sits one key away from everything else, so keep it out of normal
        // mode. It stays on Ctrl q in the other modes.
        unbind "Ctrl q"
        // Not Ctrl w: that is the terminal's own erase-word, which every shell
        // and editor inside a pane still needs.
        bind "Alt w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
    }

    move {
        bind "Ctrl b" { SwitchToMode "Normal"; }
    }

    scroll {
        bind "Ctrl l" { Clear; }
    }

    tmux clear-defaults=true {
    }

    shared_except "move" "locked" {
        bind "Ctrl b" { SwitchToMode "Move"; }
    }
}

// Ask plugins to draw without arrow fonts.
simplified_ui true

// Match the flavour alacritty.toml imports.
theme "catppuccin-frappe"

// Per pane, so this trades memory for scrollback. Default is 10000.
scroll_buffer_size 200000

show_release_notes false
show_startup_tips false
